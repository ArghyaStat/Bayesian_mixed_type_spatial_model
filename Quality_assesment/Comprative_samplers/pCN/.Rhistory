set.seed(1)
### Model
p <- 3
q <- 3
true.beta <- matrix(
c(1.0, -0.5,  0.8,
3.0,  1.5, -2.0,
-1.2,  0.0, 0.7),
nrow = p, ncol = q, byrow = TRUE
)
true.Sigma <- matrix(
c(9, 5, 4,
5, 3, 9/4,
4, 9/4, 2),
nrow = q, byrow = TRUE)
true.phi <- 0.1
true.nu <- 0.5
family <- c("Binomial", "Gaussian", "Poisson")
### Data (NO prediction)
data <- sim.data(q = q, N = 5e2,
family = family,
true.beta = true.beta,
true.Sigma = true.Sigma,
true.phi = true.phi,
true.nu = true.nu,
pred.prop = 0)
### Priors
M.prior <- matrix(0, p, q)
V.prior <- 1e2 * diag(p)
S.prior <- diag(q)
df.prior <- q + 1
### Vecchia (WORKING FIX — dummy pred)
obs.locs <- data$obs.locs
N.obs <- nrow(obs.locs)
Y.obs <- data$Y.obs
X.obs <- data$X.obs
m <- min(20, N.obs - 1)
## ordering
obs.ord <- seq_len(N.obs)
## ---- ADD ONE DUMMY LOCATION ----
dummy.loc <- matrix(colMeans(obs.locs), nrow = 1)
locs.all <- rbind(obs.locs[obs.ord, , drop = FALSE], dummy.loc)
## now size = N.obs + 1
NNarray.all <- neighbor_matrix(locs.all, m)
## distances
distall.nn <- dist.nn(locs.all, NNarray.all)
## Vecchia coeff
coeff.all <- vecchia_coeff(distall.nn, NNarray.all, true.phi, true.nu)
## ---- KEEP ONLY OBS PART ----
NNarray.obs <- NNarray.all[1:N.obs, , drop = FALSE]
distobs.nn <- distall.nn[1:N.obs]
coeff.obs <- list(
B = coeff.all$B[1:N.obs],
r = coeff.all$r[1:N.obs]
)
## reorder data
Y.obs.ord <- Y.obs[obs.ord, , drop = FALSE]
X.obs.ord <- X.obs[obs.ord, , drop = FALSE]
## b_phi
distmat.obs <- as.matrix(fields::rdist(obs.locs[obs.ord, ]))
b_phi <- max(distmat.obs) / 3
## Vecchia coefficients
coeff.obs <- vecchia_coeff(distobs.nn, NNarray.obs, true.phi, true.nu)
rm(list = ls())
