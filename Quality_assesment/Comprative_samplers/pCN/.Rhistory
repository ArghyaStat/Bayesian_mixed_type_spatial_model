N.obs <- nrow(obs.locs)   ## 🔥 SAFER than data$N.obs
Y.obs <- data$Y.obs
X.obs <- data$X.obs
## 🔥 IMPORTANT: ensure valid m
m <- min(20, N.obs - 1)
## 🔥 FIX: DO NOT reorder if max_min misbehaves
obs.ord <- max_min(obs.locs)
## Safety check
if(length(obs.ord) != N.obs){
obs.ord <- seq_len(N.obs)
}
obs.locs.ord <- obs.locs[obs.ord, , drop = FALSE]
## neighbors
NNarray.obs <- neighbor_matrix(obs.locs.ord, m)
