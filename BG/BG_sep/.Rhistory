beta.chain       <- replicate(niters, matrix(NA, p, q), simplify = FALSE)
Sigma.chain      <- replicate(niters, matrix(NA, q, q), simplify = FALSE)
chol.Sigma.chain <- replicate(niters, matrix(NA, q, q), simplify = FALSE)
phi.chain        <- rep(NA, niters)
