neigh_cond <- neigh[-idx_i]
if(length(neigh_cond) == 0){
mean_i <- M_ord[i,,drop=FALSE]
} else {
B <- matrix(B_list[[i]],1)
mean_i <- M_ord[i,,drop=FALSE] +
B %*% (W[neigh_cond,,drop=FALSE] -
M_ord[neigh_cond,,drop=FALSE])
}
# epsilon ~ N(0, r_i Sigma)
eps <- sqrt(r_vec[i]) * t(chol.Sigma) %*% rnorm(q)
eps <- t(eps)
W[i,] <- mean_i + eps
}
return(W)
}
bad_rows <- which(sapply(1:nrow(NNarray), function(i){
neigh <- NNarray[i,]
neigh <- neigh[!is.na(neigh)]
neigh <- neigh[neigh != i]   # remove self
any(neigh >= i)
}))
bad_rows
self_missing <- which(!sapply(1:nrow(NNarray),
function(i) i %in% NNarray[i,]))
print(bad_rows)
print(self_missing)
library(fields)
set.seed(1)
n_obs  <- 80
n_pred <- 20
n_tot  <- n_obs + n_pred
q      <- 2
m      <- 10
phi <- 0.3
nu  <- 1.5
loc_obs  <- matrix(runif(n_obs*2), n_obs, 2)
loc_pred <- matrix(runif(n_pred*2), n_pred, 2)
locations <- rbind(loc_obs, loc_pred)
M <- matrix(0, n_tot, q)
Sigma <- matrix(c(1,0.5,0.5,1),2,2)
cholSigma <- chol(Sigma)
D <- rdist(locations)
K <- Matern(D, range = phi, smoothness = nu)
cholK <- chol(K)
W_error <- matrix(rnorm(n_tot*q), n_tot, q)
W <- M + t(cholK) %*% W_error %*% cholSigma
W_obs <- W[1:n_obs,]
D_oo <- rdist(loc_obs)
D_pp <- rdist(loc_pred)
D_po <- rdist(loc_pred, loc_obs)
K_oo <- Matern(D_oo,phi,nu)
K_pp <- Matern(D_pp,phi,nu)
K_po <- Matern(D_po,phi,nu)
Kinv <- solve(K_oo)
mu_pred_true <- M[(n_obs+1):n_tot,] +
K_po %*% Kinv %*% (W_obs - M[1:n_obs,])
K_pred <- K_pp - K_po %*% Kinv %*% t(K_po)
dmvnorm_pred <- function(Y, Mu, Kpred, Sigma){
n <- nrow(Y)
q <- ncol(Y)
R <- Y-Mu
cholK <- chol(Kpred)
cholS <- chol(Sigma)
logdetK <- 2*sum(log(diag(cholK)))
logdetS <- 2*sum(log(diag(cholS)))
quad <- sum(solve(Sigma) * t(R) %*%
solve(Kpred) %*% R)
-0.5*(n*q*log(2*pi)+q*logdetK+n*logdetS+quad)
}
ll_true_pred <- dmvnorm_pred(W[(n_obs+1):n_tot,],
mu_pred_true,
K_pred,
Sigma)
vecchia_mean <- function(W_obs_ord,M_ord,NN,coeff){
W_hat <- W_obs_ord
n <- nrow(W_hat)
for(i in seq_len(n)){
neigh <- NN[i,]
neigh <- neigh[!is.na(neigh)]
idx_i <- which(neigh==i)
neigh_cond <- neigh[-idx_i]
if(length(neigh_cond)==0){
mean_i <- M_ord[i,,drop=FALSE]
} else{
B <- matrix(coeff$B[[i]],1)
mean_i <- M_ord[i,,drop=FALSE] +
B %*% (W_hat[neigh_cond,,drop=FALSE] -
M_ord[neigh_cond,,drop=FALSE])
}
W_hat[i,] <- mean_i
}
W_hat
}
W_vecchia_mean <- vecchia_mean(W_ord,M_ord,NNarray,coeff)
pred_idx <- which(ord > n_obs)
mu_pred_vecchia <- W_vecchia_mean[pred_idx,]
r_pred <- coeff$r[pred_idx]
K_vecchia <- diag(r_pred)
ll_vecchia_pred <- dmvnorm_pred(W_ord[pred_idx,],
mu_pred_vecchia,
K_vecchia,
Sigma)
print(c(true_predictive_ll=ll_true_pred,
vecchia_predictive_ll=ll_vecchia_pred,
difference=ll_vecchia_pred-ll_true_pred))
### Real data analysis M1
rm(list = ls())
libraries <- c("spam", "this.path", "fields", "fBasics", "MCMCpack", "truncnorm",
"rlist", "foreach","doParallel", "FNN", "mcmcse", "sp", "gstat")
# Load libraries
invisible(lapply(libraries, library, character.only = TRUE))
mydir <- this.path::here()
setwd(mydir)
source("data_simulation.R")
source("vecchia.R")
source("aux_functions_joint.R")
source("update_parameters_joint.R")
source("mixed_workflow_joint.R")
source("predictive_scores.R")
load(file.path("data_full.RData"), eva.data <- new.env())
full.data.DF <- eva.data$data_DF
full.data <- as.list(eva.data)
N.t <- 161
N.months <- 7
N.years <- 23
N.s <- 3503
t.index <- 140
spatial.subset <- seq(N.s * (t.index - 1) + 1, N.s * t.index)
data <- full.data.DF[spatial.subset, ]
k.folds <- 10
set.seed(35)
N <- nrow(data)
fold_id <- sample(rep(1:k.folds, length.out = N))
k = 1
### =========================
### 1. Split train / test
### =========================
train_idx <- which(fold_id != k)
test_idx  <- which(fold_id == k)
### Locations
locations <- cbind(data$lon, data$lat)
obs.locs  <- locations[train_idx, , drop = FALSE]
pred.locs <- locations[test_idx, , drop = FALSE]
### Design matrix
X <- cbind(1, locations)
X.obs  <- X[train_idx, , drop = FALSE]
X.pred <- X[test_idx, , drop = FALSE]
### Responses
Y_BA  <- log(1 + data$BA)
Y_CNT <- data$CNT
Y <- cbind(Y_BA, Y_CNT)
Y.obs       <- Y[train_idx, , drop = FALSE]
Y.pred.true <- Y[test_idx, , drop = FALSE]
N.obs  <- nrow(obs.locs)
N.pred <- nrow(pred.locs)
p <- ncol(X)
q <- ncol(Y)
family <- c("Gaussian", "Poisson")
### =========================
### 2. Vecchia ordering (TRAIN)
### =========================
m <- 20
obs.ord <- max_min(obs.locs)
obs.locs.ord <- obs.locs[obs.ord, , drop = FALSE]
distobs.ord <- rdist(obs.locs.ord)
diameter <- max(distobs.ord)
b_phi <- diameter/ 3
# b_phi <- median(distobs.ord) / 3
Y.obs.ord <- Y.obs[obs.ord, , drop = FALSE]
X.obs.ord <- X.obs[obs.ord, , drop = FALSE]
### =========================
### 3. Joint ordering (TRAIN + TEST)
### =========================
pred.ord <- max_min(pred.locs)
ord <- c(obs.ord, pred.ord + N.obs)
locs.all <- rbind(obs.locs, pred.locs)
locs.ord <- locs.all[ord, , drop = FALSE]
NNarray.all <- neighbor_matrix(locs.ord, m)
distall.nn  <- dist.nn(locs.ord, NNarray.all)
### Initial spatial params
# phi <- b_phi / 2
# nu  <- 0.3
### Reorder prediction
X.pred.ord <- X.pred[pred.ord, , drop = FALSE]
Y.pred.ord.true <- Y.pred.true[pred.ord, , drop = FALSE]
### =========================
### 4. Priors & Initialization
### =========================
M.prior <- matrix(0, p, q)
V.prior <- 1e2 * diag(p)
S.prior <- diag(q)
df.prior <- q + 1
W.obs.ord <- cbind(Y.obs.ord[,1], log(1 + Y.obs.ord[,2]))
Sigma <- cov(W.obs.ord)
beta <- solve(crossprod(X.obs.ord)) %*% crossprod(X.obs.ord, W.obs.ord)
# beta  <- M.prior
# Sigma <- diag(q)
# W.obs.ord <- X.obs.ord %*% beta
R <- chol(Sigma)
# 2. Whiten responses (remove cross-correlation)
W.white <- W.obs.ord %*% solve(R)
# 3. Stack responses into a single field
values <- as.vector(W.white)
coords.rep <- obs.locs.ord[rep(1:nrow(obs.locs.ord), times = ncol(W.white)), ]
# 4. Create spatial object
df.joint <- data.frame(
lon = coords.rep[,1],
lat = coords.rep[,2],
values = values
)
coordinates(df.joint) <- ~ lon + lat
# 5. Empirical variogram
emp.vario.joint <- variogram(values ~ 1, df.joint)
init.vgm <- vgm(
model = "Mat",
psill = var(values),
range = median(emp.vario.joint$dist),
nugget = 0
)
fit.vgm <- fit.variogram(emp.vario.joint, model = init.vgm, fit.sills = TRUE)
# 8. Extract phi (range parameter)
phi <- fit.vgm$range[2]
# (optional) smoothness if needed
nu <- fit.vgm$kappa[2]
coeff.all <- vecchia_coeff(distall.nn, NNarray.all, phi, nu)
out <- mixed.workflow.joint(
Y.obs.ord, X.obs.ord, obs.locs.ord, m, N.obs, p, q,
nu, W.obs.ord, beta, Sigma, phi,
M.prior, V.prior, S.prior, df.prior, b_phi,
niters, tuning.phi,
Y.pred.ord.true, X.pred.ord, N.pred,
distall.nn, coeff.all, NNarray.all,
family, family.par = NULL, link = NULL, burnin = burnin
)
tuning.phi <- b_phi/3
niters <- 1e4
burnin <- 1e4
out <- mixed.workflow.joint(
Y.obs.ord, X.obs.ord, obs.locs.ord, m, N.obs, p, q,
nu, W.obs.ord, beta, Sigma, phi,
M.prior, V.prior, S.prior, df.prior, b_phi,
niters, tuning.phi,
Y.pred.ord.true, X.pred.ord, N.pred,
distall.nn, coeff.all, NNarray.all,
family, family.par = NULL, link = NULL, burnin = burnin
)
par(mfrow = c(1,1))
pdf("traceplot_phi.pdf", width=5 ,height=5)
trace.phi <- plot.ts(out$phi.samples, ylab = "phi", main = "Traceplot of phi")
dev.off()
# Output Analysis of Sigma
labels.Sigma <- list()
for (i in 1:q) {
for (j in 1:q) {
labels.Sigma <- c(labels.Sigma,
list(paste0('Sigma (', i, ',', j, ')')))
}
}
pdf("traceplot_Sigma.pdf", width = 7.5 ,height = 6)
par(mfrow=c(q,q))
for (i in 1:q) {
for (j in 1:q) {
plot(1:niters, sapply(out$Sigma.samples, function(x) x[i, j]),
type='l', col=1, xlab='Iteration', ylab='Sigma',
main=labels.Sigma[(i-1)*q + j])
}
}
dev.off()
tuning.phi <- b_phi/6
niters <- 5e3
burnin <- 1e3
### =========================
### 5. RUN JOINT WORKFLOW
### =========================
out <- mixed.workflow.joint(
Y.obs.ord, X.obs.ord, obs.locs.ord, m, N.obs, p, q,
nu, W.obs.ord, beta, Sigma, phi,
M.prior, V.prior, S.prior, df.prior, b_phi,
niters, tuning.phi,
Y.pred.ord.true, X.pred.ord, N.pred,
distall.nn, coeff.all, NNarray.all,
family, family.par = NULL, link = NULL, burnin = burnin
)
# 8. Extract phi (range parameter)
phi <- fit.vgm$range[2]
# (optional) smoothness if needed
nu <- fit.vgm$kappa[2]
coeff.all <- vecchia_coeff(distall.nn, NNarray.all, phi, nu)
tuning.phi <- 1
niters <- 5e3
burnin <- 1e3
### =========================
### 5. RUN JOINT WORKFLOW
### =========================
out <- mixed.workflow.joint(
Y.obs.ord, X.obs.ord, obs.locs.ord, m, N.obs, p, q,
nu, W.obs.ord, beta, Sigma, phi,
M.prior, V.prior, S.prior, df.prior, b_phi,
niters, tuning.phi,
Y.pred.ord.true, X.pred.ord, N.pred,
distall.nn, coeff.all, NNarray.all,
family, family.par = NULL, link = NULL, burnin = burnin
)
tuning.phi <- 1e-2
niters <- 1e4
burnin <- 1e4
### =========================
### 5. RUN JOINT WORKFLOW
### =========================
out <- mixed.workflow.joint(
Y.obs.ord, X.obs.ord, obs.locs.ord, m, N.obs, p, q,
nu, W.obs.ord, beta, Sigma, phi,
M.prior, V.prior, S.prior, df.prior, b_phi,
niters, tuning.phi,
Y.pred.ord.true, X.pred.ord, N.pred,
distall.nn, coeff.all, NNarray.all,
family, family.par = NULL, link = NULL, burnin = burnin
)
# Traceplots
par(mfrow = c(1,1))
pdf("traceplot_phi.pdf", width=5 ,height=5)
trace.phi <- plot.ts(out$phi.samples, ylab = "phi", main = "Traceplot of phi")
dev.off()
# Output Analysis of Sigma
labels.Sigma <- list()
for (i in 1:q) {
for (j in 1:q) {
labels.Sigma <- c(labels.Sigma,
list(paste0('Sigma (', i, ',', j, ')')))
}
}
pdf("traceplot_Sigma.pdf", width = 7.5 ,height = 6)
par(mfrow=c(q,q))
for (i in 1:q) {
for (j in 1:q) {
plot(1:niters, sapply(out$Sigma.samples, function(x) x[i, j]),
type='l', col=1, xlab='Iteration', ylab='Sigma',
main=labels.Sigma[(i-1)*q + j])
}
}
dev.off()
